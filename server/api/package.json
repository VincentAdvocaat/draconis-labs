{
  "name": "@draconis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "openapi:update": "tsx scripts/update-openapi-snapshot.ts",
    "smoke:start": "node scripts/smoke-start.mjs",
    "planner:data": "tsx scripts/planner-snapshots.ts",
    "planner:channel": "tsx scripts/create-public-channel.ts",
    "planner:agent": "tsx scripts/agent-credentials.ts",
    "planner:audit": "tsx scripts/planner-audit.ts",
    "start:public": "node --import tsx dist/public.js",
    "smoke:public": "node scripts/smoke-public.mjs",
    "smoke:planner-postgres": "node scripts/smoke-planner-postgres.mjs",
    "demo:local": "node scripts/demo-local.mjs"
  },
  "dependencies": {
    "@draconis/planner-core": "workspace:*",
    "@draconis/planner-postgres": "workspace:*",
    "@draconis/planner-sqlite": "workspace:*",
    "@draconis/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@modelcontextprotocol/server": "2.4.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "pg": "^8.16.3",
    "sharp": "0.35.5",
    "tsx": "^4.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.6",
    "oxlint": "^1.73.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18"
  }
}
